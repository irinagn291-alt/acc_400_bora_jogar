{
  "sourceLanguage": "en",
  "strings": {
    "NSCalendarsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a team fixture to your calendar when you choose Add to Calendar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie um jogo da equipe ao calendário ao escolher Adicionar ao Calendário."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge auf Wunsch einen Teamtermin über Zum Kalender hinzufügen hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un match au calendrier en choisissant Ajouter au calendrier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un partido al calendario cuando elijas Añadir al calendario."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia una partita al calendario scegliendo Aggiungi al calendario."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the football fixture you choose without reading your other calendar events."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve o jogo escolhido sem ler seus outros eventos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere den gewählten Fußballtermin, ohne andere Kalenderereignisse zu lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez le match choisi sans lire vos autres événements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el partido elegido sin leer tus otros eventos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva la partita scelta senza leggere gli altri eventi."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort the bundled court directory by your approximate distance. You can also search by city."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene as quadras do diretório pela distância aproximada. Você também pode buscar por cidade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiere das Platzverzeichnis nach ungefährer Entfernung. Du kannst auch nach Stadt suchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Triez les terrains par distance approximative. Vous pouvez aussi chercher par ville."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena las canchas por distancia aproximada. También puedes buscar por ciudad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina i campi per distanza approssimativa. Puoi anche cercare per città."
          }
        }
      }
    }
  },
  "version": "1.0"
}