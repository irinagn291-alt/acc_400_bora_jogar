    "Messages appear after organizer approval. No links, personal contacts or abusive content. Reports hide the author immediately on your device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages appear after organizer approval. No links, personal contacts or abusive content. Reports hide the author immediately on your device."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagens aparecem após aprovação do organizador. Sem links, contatos pessoais ou ofensas. Denúncias ocultam o autor imediatamente neste dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten erscheinen nach Freigabe durch den Organisator. Keine Links, Kontaktdaten oder beleidigenden Inhalte. Meldungen blenden den Autor sofort auf deinem Gerät aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages apparaissent après approbation. Aucun lien, contact personnel ou contenu abusif. Un signalement masque immédiatement l'auteur sur votre appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes aparecen tras la aprobación. Sin enlaces, contactos personales ni contenido abusivo. Denunciar oculta al autor en tu dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi appaiono dopo l'approvazione. Niente link, contatti personali o contenuti offensivi. Le segnalazioni nascondono subito l'autore sul dispositivo."
          }
        }
      }
    },
