{
  "sourceLanguage": "en",
  "strings": {
    "3 points for a win, 1 for a draw. Ties: goal difference, goals scored, team name. Cancelled matches do not count.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 points for a win, 1 for a draw. Ties: goal difference, goals scored, team name. Cancelled matches do not count."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitória: 3 pontos; empate: 1. Desempate: saldo de gols, gols marcados e nome da equipe. Jogos cancelados não contam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieg: 3 Punkte, Unentschieden: 1. Gleichstand: Tordifferenz, erzielte Tore, Teamname. Abgesagte Spiele zählen nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Victoire : 3 points, nul : 1. Égalité : différence de buts, buts marqués, nom d'équipe. Les matchs annulés ne comptent pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Victoria: 3 puntos; empate: 1. Desempate: diferencia de goles, goles marcados y nombre. Los partidos cancelados no cuentan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vittoria: 3 punti; pareggio: 1. Parità: differenza reti, gol segnati e nome squadra. Le partite annullate non contano."
          }
        }
      }
    },
