    "This is a reference listing, not a reservation service. Check the venue before traveling.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference listing, not a reservation service. Check the venue before traveling."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Listagem de referência. Não é serviço de reservas. Confira com o local antes de ir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Verzeichniseintrag, kein Reservierungsdienst. Prüfe den Platz vor der Anreise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est une fiche de référence, pas un service de réservation. Vérifiez le lieu avant de partir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una referencia, no un servicio de reservas. Consulta al lugar antes de viajar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una scheda informativa, non un servizio di prenotazione. Verifica prima di partire."
          }
        }
      }
    },
