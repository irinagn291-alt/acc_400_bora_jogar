    "Attendance syncs when the app opens. Unsynced responses stay on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendance syncs when the app opens. Unsynced responses stay on this device."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A presença sincroniza ao abrir o app. Respostas não enviadas ficam neste dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilnahmen werden beim Öffnen synchronisiert. Ungesendete Antworten bleiben auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La présence se synchronise à l'ouverture. Les réponses non envoyées restent sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La asistencia se sincroniza al abrir la app. Las respuestas sin enviar quedan aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La presenza si sincronizza all'apertura. Le risposte non inviate restano sul dispositivo."
          }
        }
      }
    },
