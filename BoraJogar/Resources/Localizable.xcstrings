    "Have an invitation? Open the iCloud link from your organizer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have an invitation? Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recebeu um convite? Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du eine Einladung? Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une invitation ? Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tienes invitación? Abre un archivo o envía una copia directamente. Los cambios quedan en este dispositivo hasta que vuelvas a compartirlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
